# baresip 最小化 config (for Flutter FFI)

# SIP
sip_verify_server no

# Call
call_local_timeout 120
call_max_calls 2

# Audio codecs
module g711.so

# Audio filters
module auconv.so
module auresamp.so

# Audio drivers
module aubridge.so

# NAT / ICE
module stun.so
module turn.so
module ice.so

# App modules
module_app account.so
module_app contact.so
module_app menu.so
